# ZhiJi local development. The open-source API is Loligo.
# Onykia is the closed-source gateway in front of Loligo.

NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_BACKEND=loligo
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PASSWORD_HASH_ENABLED=false
NEXT_PUBLIC_PRIVACY_CONSENT_REQUIRED=true
NEXT_PUBLIC_DEV_MOCK_AUTH=false

# Docker runtime. ZHIJI_BACKEND is loligo or onykia.
ZHIJI_API_URL=/api
ZHIJI_BACKEND=loligo
ZHIJI_DEFAULT_LOCALE=zh-CN
ZHIJI_SUPPORT_EMAIL=
ZHIJI_UPLOAD_ORIGINS=
ZHIJI_PASSWORD_RESET_ENABLED=false

PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Server-side task route checks. Must be reachable from the ZhiJi process.
# ZHIJI_SERVER_API_URL=http://loligo:8080/api
