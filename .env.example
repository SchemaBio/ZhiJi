# ZhiJi standalone development configuration.
# Production deployments use Onykia/deploy or Loligo/deploy.

NEXT_PUBLIC_API_URL=http://localhost:8082/api
NEXT_PUBLIC_BACKEND=loligo
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PASSWORD_HASH_ENABLED=false
NEXT_PUBLIC_PRIVACY_CONSENT_REQUIRED=true
# Build-time opt-in; keep false until performance/equivalence acceptance.
NEXT_PUBLIC_ASSESSMENT_OPTIMIZED=false
NEXT_PUBLIC_DEV_MOCK_AUTH=false

# Docker runtime settings. ZHIJI_BACKEND is loligo or onykia.
ZHIJI_API_URL=/api
ZHIJI_BACKEND=loligo
# zh-CN, zh-Hant, en, es-419
ZHIJI_DEFAULT_LOCALE=zh-CN
ZHIJI_SUPPORT_EMAIL=
ZHIJI_UPLOAD_ORIGINS=

PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Optional server-side task route checks; must be reachable from the ZhiJi process.
# ZHIJI_SERVER_API_URL=http://loligo:8080/api
